# Server-only values; enter secrets in the hosting dashboard, NEVER in GitHub.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service-role JWT is an alternative; leave empty when using a secret key.
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://pikli-website.vercel.app
# Fail closed by default. Database settings/product approvals are also required.
PIKLI_LIVE_APPROVED=false
# At least 32 random characters. Used only to hash rate-limit identifiers.
PIKLI_RATE_LIMIT_SALT=
